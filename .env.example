# EntitlementShield — environment template. Copy to `.env` (gitignored) and edit.
# Synthetic data only; no real credentials belong here.

# Inference database (accounts, events, linkage, clusters, decisions, audit).
DATABASE_URL=sqlite:///data/synthetic/dev.db

# Ground truth lives in a PHYSICALLY SEPARATE store (docs/phase-1-plan.md Step 1,
# review 4 P1-4a). Detector services must never receive this handle.
GROUND_TRUTH_DATABASE_URL=sqlite:///data/synthetic/ground_truth.db

# Deterministic world generation (docs/phase-1-plan.md Step 2).
WORLD_SEED=1

# LLM reviewer — Phase 3 only; unused in Phase 1. Provider-neutral (docs/architecture.md §5).
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=
